<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smartcar">
  <xacro:arg name="use_gazebo" default="true"/>
  <xacro:arg name="calibration_file" default="$(find smartcar_description)/config/nominal.yaml"/>
  <xacro:property name="calibration" value="${xacro.load_yaml('$(arg calibration_file)')}"/>
  <xacro:property name="model" value="${calibration['model']}"/>
  <xacro:property name="wheel_radius" value="${model['wheel_radius']}"/>
  <xacro:property name="wheel_separation" value="${model['wheel_separation']}"/>
  <xacro:property name="wheel_width" value="${model['wheel_width']}"/>
  <xacro:property name="body_length" value="${model['body_length']}"/>
  <xacro:property name="body_width" value="${model['body_width']}"/>
  <xacro:property name="body_height" value="${model['body_height']}"/>
  <xacro:property name="body_mass" value="${model['body_mass']}"/>
  <xacro:property name="body_z" value="${model['body_z']}"/>
  <xacro:property name="inertia_xx" value="${model['inertia_xx']}"/>
  <xacro:property name="inertia_yy" value="${model['inertia_yy']}"/>
  <xacro:property name="inertia_zz" value="${model['inertia_zz']}"/>
  <xacro:property name="caster_clearance" value="${model['caster_clearance']}"/>

  <material name="blue"><color rgba="0.08 0.28 0.78 1.0"/></material>
  <material name="black"><color rgba="0.025 0.025 0.025 1.0"/></material>
  <material name="red"><color rgba="0.85 0.08 0.06 1.0"/></material>
  <material name="green"><color rgba="0.08 0.75 0.18 1.0"/></material>
  <material name="grey"><color rgba="0.35 0.35 0.38 1.0"/></material>

  <!-- base_link is the wheel axle midpoint projected to the ground. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${body_z}"/>
      <mass value="${body_mass}"/>
      <!-- Solid 0.180 x 0.110 x 0.020 m box; values satisfy Gazebo's
           positive-definite inertia triangle inequalities. -->
      <!-- Slightly conservative values leave margin after Gazebo combines the
           fixed sensor / caster links into base_link. -->
      <inertia ixx="${inertia_xx}" ixy="0" ixz="0" iyy="${inertia_yy}" iyz="0" izz="${inertia_zz}"/>
    </inertial>
    <visual><origin xyz="0 0 ${body_z}"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 ${body_z}"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry></collision>
  </link>
  <link name="chassis_link"/>
  <joint name="base_to_chassis" type="fixed"><parent link="base_link"/><child link="chassis_link"/><origin xyz="${model['chassis_xyz']}" rpy="${model['chassis_rpy']}"/></joint>

  <link name="left_wheel">
    <inertial><mass value="0.06"/><inertia ixx="0.000012" ixy="0" ixz="0" iyy="0.000017" iyz="0" izz="0.000012"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
    <!-- Rounded tread avoids flat-cylinder inner-rim contacts changing the
         effective track width in DART; dimensions remain 48 x 18 x 48 mm. -->
    <collision><geometry><mesh filename="file://$(find smartcar_description)/meshes/unit_sphere.stl" scale="${wheel_radius} ${wheel_width / 2.0} ${wheel_radius}"/></geometry></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 ${wheel_separation / 2.0} ${wheel_radius}"/><axis xyz="0 1 0"/></joint>

  <link name="right_wheel">
    <inertial><mass value="0.06"/><inertia ixx="0.000012" ixy="0" ixz="0" iyy="0.000017" iyz="0" izz="0.000012"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
    <collision><geometry><mesh filename="file://$(find smartcar_description)/meshes/unit_sphere.stl" scale="${wheel_radius} ${wheel_width / 2.0} ${wheel_radius}"/></geometry></collision>
  </link>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 ${-wheel_separation / 2.0} ${wheel_radius}"/><axis xyz="0 1 0"/></joint>

  <link name="front_caster"><inertial><mass value="0.025"/><inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000002"/></inertial><visual><geometry><sphere radius="0.012"/></geometry><material name="grey"/></visual><collision><geometry><sphere radius="0.012"/></geometry></collision></link>
  <joint name="front_caster_joint" type="fixed"><parent link="base_link"/><child link="front_caster"/><origin xyz="0.070 0 ${0.012 + caster_clearance}"/></joint>
  <link name="rear_caster"><inertial><mass value="0.025"/><inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000002"/></inertial><visual><geometry><sphere radius="0.012"/></geometry><material name="grey"/></visual><collision><geometry><sphere radius="0.012"/></geometry></collision></link>
  <joint name="rear_caster_joint" type="fixed"><parent link="base_link"/><child link="rear_caster"/><origin xyz="-0.070 0 ${0.012 + caster_clearance}"/></joint>

  <link name="laser_link"><visual><origin xyz="0 0 0.0125"/><geometry><cylinder radius="0.035" length="0.025"/></geometry><material name="red"/></visual></link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="${model['laser_xyz']}" rpy="${model['laser_rpy']}"/></joint>
  <link name="imu_link"><visual><geometry><box size="0.028 0.020 0.008"/></geometry><material name="green"/></visual></link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="${model['imu_xyz']}" rpy="${model['imu_rpy']}"/></joint>

  <xacro:if value="$(arg use_gazebo)">
  <gazebo reference="base_link"><gravity>true</gravity><self_collide>false</self_collide></gazebo>
  <gazebo reference="front_caster"><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>
  <gazebo reference="rear_caster"><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>
  <gazebo reference="laser_link">
    <sensor name="x3pro_lidar" type="gpu_lidar"><always_on>true</always_on><visualize>true</visualize><update_rate>10</update_rate><topic>/car/scan</topic><gz_frame_id>laser_link</gz_frame_id><lidar><scan><horizontal><samples>400</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan><range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range></lidar></sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="mpu6050_imu" type="imu"><always_on>true</always_on><update_rate>100</update_rate><topic>/car/imu/gz</topic><gz_frame_id>imu_link</gz_frame_id><imu><angular_velocity><x><noise type="gaussian"><mean>0.0</mean><stddev>0.0005</stddev></noise></x><y><noise type="gaussian"><mean>0.0</mean><stddev>0.0005</stddev></noise></y><z><noise type="gaussian"><mean>0.0</mean><stddev>0.0005</stddev></noise></z></angular_velocity><linear_acceleration><x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x><y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y><z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z></linear_acceleration></imu></sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>${wheel_separation}</wheel_separation><wheel_radius>${wheel_radius}</wheel_radius><topic>/car/chassis/cmd_vel/gz</topic><odom_topic>/car/chassis/odom/gz</odom_topic><tf_topic>/smartcar/gz/tf</tf_topic><frame_id>chassis_odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>50</odom_publish_frequency><max_linear_velocity>0.20</max_linear_velocity><max_angular_velocity>1.20</max_angular_velocity></plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/joint_states</topic><joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name><update_rate>50</update_rate></plugin>
  </gazebo>
  </xacro:if>
</robot>
