Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [ /Global Options1, /Map1, /RobotModel1, /LaserScan1, /TF1 ]
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic: /map
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      Visual Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic: /car/scan
      Size (m): 0.02
      Style: Points
      Color: 255; 40; 40
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Global Plan
      Topic: /plan
      Color: 20; 200; 30
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Local Plan
      Topic: /local_plan
      Color: 255; 180; 20
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 20
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1400
