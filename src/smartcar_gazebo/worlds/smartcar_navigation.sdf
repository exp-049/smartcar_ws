<?xml version="1.0"?>
<sdf version="1.9">
  <world name="smartcar_navigation_world">
    <gravity>0 0 -9.81</gravity>
    <physics name="fast" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <!-- Gazebo Harmonic exposes model IMU sensors through this system. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.45 0.45 0.45 1</ambient><background>0.08 0.08 0.10 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><cast_shadows>true</cast_shadows><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.4 0.2 -1</direction></light>

    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry><material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual></link></model>

    <!-- Room, corridor and turn; asymmetric layout gives Cartographer useful geometry. -->
    <model name="wall_north"><static>true</static><pose>0 3.0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8 0.15 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.15 1</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -3.0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8 0.15 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.15 1</size></box></geometry></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-4 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 6 1</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>4 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 6 1</size></box></geometry></visual></link></model>
    <model name="inner_wall"><static>true</static><pose>0.7 0.4 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.8 0.14 1</size></box></geometry></collision><visual name="v"><geometry><box><size>2.8 0.14 1</size></box></geometry></visual></link></model>
    <model name="turn_wall"><static>true</static><pose>-1.8 -1.1 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.14 2.3 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.14 2.3 1</size></box></geometry></visual></link></model>
    <model name="obstacle_box"><static>true</static><pose>2.0 -1.25 0.25 0 0 0.3</pose><link name="link"><collision name="c"><geometry><box><size>0.55 0.55 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.55 0.55 0.5</size></box></geometry><material><ambient>0.8 0.2 0.05 1</ambient><diffuse>0.9 0.25 0.05 1</diffuse></material></visual></link></model>
    <model name="obstacle_pillar"><static>true</static><pose>-2.5 1.3 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry><material><ambient>0.1 0.65 0.2 1</ambient><diffuse>0.1 0.75 0.2 1</diffuse></material></visual></link></model>
  </world>
</sdf>
