        <mxCell id="c_result" value="适合研究传感器融合本身。&lt;br&gt;迁移、标定与参数验证工作较多。&lt;br&gt;未验证 X3 Pro / MPU6050 的开箱适配。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#33465B;" vertex="1" parent="1">
