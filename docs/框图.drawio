        <mxCell id="c_sensors" value="&lt;div style=&quot;font-size:18px;font-weight:700;line-height:1.35&quot;&gt;激光 ＋ IMU ＋ 轮速约束&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.4;margin-top:5px&quot;&gt;在同一估计框架中联合优化&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontColor=#23384D;fillColor=#FFF4DD;strokeColor=#C99B43;" vertex="1" parent="1">
